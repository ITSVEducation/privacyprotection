{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python -m pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/guard-dependency-pins.ps1",
            "timeout": 30,
            "statusMessage": "依存ピンを検証中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/verify-privacy-invariants.ps1",
            "timeout": 300,
            "statusMessage": "プライバシー不変条件を検証中..."
          }
        ]
      }
    ]
  }
}
